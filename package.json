{
  "name": "workloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm -C apps/server dev\" \"pnpm -C apps/web dev\"",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "doctor": "bash scripts/doctor.sh"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "concurrently": "^9.1.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
